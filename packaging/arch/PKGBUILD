# Maintainer: legacy7838-create <234553245+legacy7838-create@users.noreply.github.com>
# Built by .github/workflows/release.yml, which fills in pkgver and the checksum
# of the source tarball it makes from the tagged commit:
#   git archive --prefix=spritx-terminal-<version>/ -o spritx-terminal-<version>.tar.gz HEAD
pkgname=spritx-terminal
pkgver=0.0.1
pkgrel=1
pkgdesc="A GPU-accelerated terminal with built-in remote control"
arch=('x86_64')
url="https://github.com/legacy7838-create/SpritX-terminal"
license=('MIT')
# The binary links libxcb and libxkbcommon(-x11); Vulkan and the font stack are
# loaded at runtime but still needed to draw anything.
depends=(
  'gcc-libs'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'fontconfig'
  'freetype2'
)
makedepends=('cargo' 'rust')
optdepends=(
  'vulkan-driver: GPU driver for the Vulkan renderer'
  'cloudflared: Internet tunnel for remote control'
)
# Arch's makepkg.conf turns LTO on globally and that LTO reaches the Rust build,
# where ring's C/assembly crypto loses its internal `ring_core_*` symbols at link
# time (briansmith/ring#2746). The release profile in Cargo.toml is what this
# package wants anyway.
options=(!lto)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  # rust-lld is Arch's default; ring's prebuilt assembly and lld do not get
  # along, so drive the link with gcc like the other packages here.
  export RUSTFLAGS="${RUSTFLAGS:-} -C linker=gcc"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/spritx-terminal "$pkgdir/usr/bin/spritx-terminal"
  install -Dm644 packaging/spritx-terminal.desktop \
    "$pkgdir/usr/share/applications/spritx-terminal.desktop"
  install -Dm644 assets/icon-256.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/spritx-terminal.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
